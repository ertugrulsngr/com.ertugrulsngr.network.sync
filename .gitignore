# Unity UPM package .gitignore (package root, not a Unity project)
# Keep ALL .meta files — they hold GUIDs required for Package Manager installs.
# Do NOT add a blanket *.meta ignore rule.
#
# Refs:
# - https://www.angry-shark-studio.com/blog/create-unity-package-github-package-manager/
# - https://github.com/github/gitignore/blob/main/Unity.gitignore (adapted)

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors / IDEs
.idea/
.vs/
.vscode/
*.code-workspace
*.swp
*~
*.user
*.userprefs
*.suo
*.DotSettings.user

# Autogenerated VS / Rider / Mono solution junk
# (can appear if the package is opened as its own solution)
*.csproj
*.unityproj
*.sln
*.slnx
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
ExportedObj/
.consulo/

# Logs / temp / crash
*.log
*.tmp
*.temp
~$*
sysinfo.txt
mono_crash.*

# Local Unity project artifacts (if someone opens/embeds this folder wrongly)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
.utmp/

# Package builds / archives (not source)
*.unitypackage
*.unitypackage.meta
*.tgz
*.tar.gz
